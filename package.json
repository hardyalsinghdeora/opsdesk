{
  "name": "opsdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted MCP server for service businesses: Claude Code tools for CRM records, quotes and workflows, with an approval gateway, per-person tokens and a tamper-evident audit log.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "aiops": "node src/cli/aiops.ts",
    "worker": "node src/worker.ts",
    "db:migrate": "node scripts/migrate.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
