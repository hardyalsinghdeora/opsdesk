# Copy to .env and adjust. Never commit real keys.
PORT=3000

# Postgres. Leave unset to run on the in-memory store (dev/demo only).
# DATABASE_URL=postgres://opsdesk:opsdesk@localhost:5432/opsdesk

# Model access. Without it, the deterministic fake extractor is used.
# ANTHROPIC_API_KEY=
# OPSDESK_EXTRACTOR=anthropic   # anthropic | fake

# API keys: JSON array of {key, tenant, actor, role}. role: ingest | operator | admin
# Unset outside production = generated dev keys, printed at startup.
# OPSDESK_API_KEYS=[{"key":"change-me","tenant":"gulfcool","actor":"ops@gulfcool.example","role":"operator"}]
