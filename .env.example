# Copy to .env and fill in. Never commit the real file.

# The address your team's Claude Code connects to (use https outside your own computer).
OPSDESK_PUBLIC_URL=https://ai.yourcompany.com
PORT=3000

# Database. docker-compose.yml sets this for you; set it yourself only when running without Docker.
# DATABASE_URL=postgres://opsdesk:opsdesk@localhost:5432/opsdesk

# AI model key, billed to your company. Without it the server uses a keyword stand-in (not allowed in production).
# ANTHROPIC_API_KEY=
# OPSDESK_EXTRACTOR=anthropic   # anthropic | fake

# People do not go here: add each person with "aiops users add", which prints their connect command.

# How often the worker reads each mailbox, in seconds (minimum 15).
# OPSDESK_POLL_SECONDS=60

# Connector secrets. Packs name these variables (e.g. client_id_ref: GMAIL_CLIENT_ID); the values live only here.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# HUBSPOT_TOKEN=
